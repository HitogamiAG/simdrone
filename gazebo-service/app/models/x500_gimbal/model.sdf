<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_gimbal">
    <!-- Reuse the PX4 X500 airframe and attach the gimbal at its mount point. -->
    <include merge="true">
      <uri>model://x500</uri>
    </include>
    <include merge="true">
      <uri>model://gimbal_camera</uri>
      <pose>0 0 0.26 0 0 3.14</pose>
    </include>
    <!-- Sensor-only link for an external chase camera, fixed behind the airframe. -->
    <link name="third_person_camera_link">
      <pose relative_to="base_link">-2.5 0 1.2 0 0 0</pose>
      <kinematic>true</kinematic>
      <gravity>false</gravity>
      <inertial>
        <mass>0.0001</mass>
        <inertia>
          <ixx>1e-8</ixx><iyy>1e-8</iyy><izz>1e-8</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- No visual or collision geometry: the link only carries the camera sensor. -->
      <sensor name="third_person_camera" type="camera">
        <pose>0 0 0 0 0.45 0</pose>
        <camera>
          <horizontal_fov>1.5</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>1000</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>25</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="ThirdPersonCameraAttachJoint" type="fixed">
      <parent>base_link</parent>
      <child>third_person_camera_link</child>
    </joint>
    <joint name="GimbalAttachJoint" type="fixed">
      <parent>base_link</parent>
      <child>cgo3_mount_link</child>
    </joint>
  </model>
</sdf>
